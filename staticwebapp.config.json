{
  "trailingSlash": "auto",
  "routes": [
    { "route": "/src/*", "statusCode": 404 },
    { "route": "/tools/*", "statusCode": 404 }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json":  "application/json",
    ".woff":  "font/woff",
    ".woff2": "font/woff2",
    ".mp4":   "video/mp4",
    ".webm":  "video/webm"
  }
}
